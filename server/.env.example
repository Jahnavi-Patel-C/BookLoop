# ============================================================
# BOOKLOOP BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to server/.env for local development or set as environment
# variables in your production hosting platform (e.g., Render).
# ============================================================

# Environment mode: 'development' | 'production'
# In production:
# - JWT_SECRET is strictly mandatory (>= 32 chars)
# - Dev user seeding (Alice/Bob) and automatic migrations are disabled
# - MongoMemoryServer fallback is disabled (requires valid MONGODB_URI)
NODE_ENV=development

# Server HTTP Port (Render sets this dynamically, defaults to 10000 on Render, 5000 locally)
PORT=5000

# MongoDB Connection String:
# - Local dev: mongodb://localhost:27017/bookloop
# - Production (MongoDB Atlas): mongodb+srv://<username>:<password>@<cluster>.mongodb.net/bookloop?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/bookloop

# Frontend Client Origin (Used for CORS and Socket.IO allowed origins):
# - Local dev: http://localhost:5173
# - Production (e.g. Vercel deployment): https://your-bookloop-client.vercel.app
CLIENT_URL=http://localhost:5173

# JWT Authentication Secret & Session Duration:
# - In production: MANDATORY. Must be a cryptographically strong string at least 32 characters long.
#   Generate with: openssl rand -hex 32
# - In development: Optional fallback is provided for zero-config testing.
JWT_SECRET=replace_with_at_least_32_characters_secret_in_production
JWT_EXPIRES_IN=7d

# Cross-Origin Cookie SameSite Setting:
# - Local development (same origin / Vite proxy): 'lax'
# - Production cross-site architectures (e.g. Vercel frontend -> Render backend): 'none'
#   (Note: When set to 'none', cookies automatically enforce 'secure: true')
COOKIE_SAME_SITE=lax
