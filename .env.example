# ============================================================
# BOOKLOOP ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to server/.env (and client/.env for Vite frontend)
# ============================================================

# ------------------------------------------------------------
# BACKEND (server/.env)
# ------------------------------------------------------------
# Environment mode: 'development' | 'production'
NODE_ENV=development

# Server HTTP Port
PORT=5000

# MongoDB Connection String:
# - Local dev: mongodb://localhost:27017/bookloop
# - Production Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/bookloop?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/bookloop

# Frontend Client Origin (Allowed by CORS):
# - Local dev: http://localhost:5173
# - Production Vercel: https://bookloop.vercel.app
CLIENT_URL=http://localhost:5173

# JWT Authentication Secret & Session Duration
# In production, generate a secure random key (e.g. `openssl rand -hex 32`)
JWT_SECRET=replace_with_strong_random_secret_in_production
JWT_EXPIRES_IN=7d

# Cross-Origin Cookie SameSite Setting:
# - Local development (same origin / proxy): 'lax'
# - Cross-domain production (e.g. Vercel -> Render): 'none'
COOKIE_SAME_SITE=lax

# ------------------------------------------------------------
# FRONTEND (client/.env)
# ------------------------------------------------------------
# Base API URL:
# - Local dev: leave empty to use Vite local proxy (/api)
# - Production Vercel: https://bookloop-api.onrender.com/api
# VITE_API_URL=https://bookloop-api.onrender.com/api

# WebSocket Server URL for Socket.IO:
# - Local dev: leave empty to use window.origin
# - Production Vercel: https://bookloop-api.onrender.com
# VITE_SERVER_URL=https://bookloop-api.onrender.com
